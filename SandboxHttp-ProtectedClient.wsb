<Configuration>
  <vGPU>Disable</vGPU>
  <Networking>Enable</Networking>
  <ProtectedClient>Enable</ProtectedClient>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\Projects\SandboxNetworkTest\guest</HostFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>D:\Projects\SandboxNetworkTest\runtime</HostFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File C:\Users\WDAGUtilityAccount\Desktop\guest\Start-HttpListener.ps1 -Port 8080 -UdpPort 8081 -TestOutboundInternet</Command>
  </LogonCommand>
</Configuration>
